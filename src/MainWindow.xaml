<Window x:Class="Rogerin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rogerin" Width="1180" Height="800" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Ground}" Foreground="{StaticResource Ink}"
        FontFamily="{StaticResource Ui}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Barra lateral -->
        <DockPanel Background="{StaticResource Sidebar}">
            <DockPanel DockPanel.Dock="Top" Margin="18,22,18,22">
                <Image Source="Assets/logo.png" Width="44" Height="44" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"
                       DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Rogerin" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Otimização do Windows" Foreground="{StaticResource SidebarText}" FontSize="11" Margin="0,1,0,0"/>
                </StackPanel>
            </DockPanel>
            <TextBlock DockPanel.Dock="Bottom" x:Name="VersionText" Foreground="{StaticResource Faint}" FontSize="11" Margin="22,0,22,18" TextWrapping="Wrap"/>
            <StackPanel>
                <RadioButton x:Name="NavTweaks" Style="{StaticResource Nav}" GroupName="nav" IsChecked="True" Checked="Nav_Checked" Content="Ajustes"/>
                <RadioButton x:Name="NavComputer" Style="{StaticResource Nav}" GroupName="nav" Checked="Nav_Checked" Content="Computador"/>
                <RadioButton x:Name="NavHistory" Style="{StaticResource Nav}" GroupName="nav" Checked="Nav_Checked" Content="Histórico e logs"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Faixa do sistema -->
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,10">
                <DockPanel>
                    <TextBlock x:Name="BusyText" DockPanel.Dock="Right" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                    <WrapPanel>
                        <StackPanel Margin="0,0,28,0">
                            <TextBlock Style="{StaticResource Label}" Text="SISTEMA"/>
                            <TextBlock x:Name="OsText" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,28,0">
                            <TextBlock Style="{StaticResource Label}" Text="COMPUTADOR"/>
                            <TextBlock x:Name="MachineText" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,28,0">
                            <TextBlock Style="{StaticResource Label}" Text="USUÁRIO QUE RECEBE OS AJUSTES"/>
                            <TextBlock x:Name="UserText" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </WrapPanel>
                </DockPanel>
            </Border>

            <!-- ============ AJUSTES (principal) ============ -->
            <DockPanel x:Name="PageTweaks" Grid.Row="1">
                <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,12">
                    <DockPanel>
                        <Button x:Name="ApplyButton" DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Click="Review_Click"
                                Padding="26,11" FontSize="14" Content="Aplicar selecionados"/>
                        <CheckBox x:Name="RestorePointBox" DockPanel.Dock="Right" IsChecked="True" Margin="0,0,20,0" FontSize="13"
                                  Content="Criar ponto de restauração"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="SelectionText" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock x:Name="StatusLine" Style="{StaticResource Body}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ScrollViewer x:Name="TweakScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,20,24,16">
                        <TextBlock Style="{StaticResource H1}" Text="O que você quer otimizar?"/>
                        <TextBlock Style="{StaticResource Body}" Margin="0,4,0,14"
                                   Text="Escolha um nível e clique em Aplicar. Você pode marcar ou desmarcar qualquer item. Nada muda antes da confirmação."/>

                        <StackPanel x:Name="Banners"/>

                        <UniformGrid Columns="3" Margin="-5,0,-5,0">
                            <RadioButton x:Name="LevelBasic" Style="{StaticResource LevelCard}" GroupName="level" Margin="5" Checked="Level_Checked" Tag="Basic">
                                <StackPanel>
                                    <TextBlock Text="Básico" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Body}" Margin="0,3,0,8" Text="Só itens seguros. Indicado para qualquer computador."/>
                                    <TextBlock x:Name="CountBasic" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="LevelRecommended" Style="{StaticResource LevelCard}" GroupName="level" Margin="5" Checked="Level_Checked" Tag="Recommended">
                                <StackPanel>
                                    <TextBlock Text="Recomendado" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Body}" Margin="0,3,0,8" Text="Básico mais desempenho e remoção de apps pré-instalados."/>
                                    <TextBlock x:Name="CountRecommended" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="LevelComplete" Style="{StaticResource LevelCard}" GroupName="level" Margin="5" Checked="Level_Checked" Tag="Complete">
                                <StackPanel>
                                    <TextBlock Text="Completo" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Body}" Margin="0,3,0,8" Text="Tudo, inclusive itens avançados. Para técnicos."/>
                                    <TextBlock x:Name="CountComplete" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>

                        <DockPanel Margin="0,14,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource LinkButton}" Content="Marcar tudo" Click="SelectAll_Click" Margin="0,0,4,0"/>
                                <Button Style="{StaticResource LinkButton}" Content="Desmarcar tudo" Click="SelectNone_Click"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Body}" VerticalAlignment="Center"
                                       Text="Itens já aplicados aparecem apagados. Passe o mouse para ver a chave e o valor atual."/>
                        </DockPanel>

                        <ItemsControl x:Name="OptionList" Focusable="False">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,16,0,8">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Marcar categoria"
                                                        Click="SelectGroup_Click" Tag="{Binding Name}"/>
                                                <TextBlock VerticalAlignment="Center">
                                                    <Run Text="{Binding Name, Mode=OneWay}" FontSize="15" FontWeight="SemiBold"/>
                                                    <Run Text="{Binding ItemCount, Mode=OneWay, StringFormat=' · {0} itens'}" Foreground="{StaticResource Muted}" FontSize="13"/>
                                                </TextBlock>
                                            </DockPanel>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource OptionRow}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}"
                                              Opacity="{Binding RowOpacity}" ToolTip="{Binding Details}" ToolTipService.ShowDuration="60000"
                                              ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding Name}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <WrapPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding RiskLabel}" Foreground="{Binding RiskFg}" FontSize="12" FontWeight="SemiBold" Margin="0,2,10,0"/>
                                                    <Border Style="{StaticResource Chip}" Background="{StaticResource InfoBg}" Visibility="{Binding GpoVisibility}" Margin="0,0,6,0"
                                                            ToolTip="Política: uma GPO do domínio pode sobrescrever este valor no próximo gpupdate.">
                                                        <TextBlock Text="GPO pode sobrescrever" FontSize="11" Foreground="{StaticResource InfoFg}"/>
                                                    </Border>
                                                    <Border Style="{StaticResource Chip}" Background="{StaticResource NaBg}" Visibility="{Binding RebootVisibility}">
                                                        <TextBlock Text="Requer reinício" FontSize="11" Foreground="{StaticResource NaFg}"/>
                                                    </Border>
                                                </WrapPanel>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Body}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource Chip}" Background="{Binding StatusBg}" VerticalAlignment="Top" MinWidth="96">
                                                <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusFg}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- ============ COMPUTADOR (secundária) ============ -->
            <ScrollViewer x:Name="PageComputer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="24,20">
                    <TextBlock Style="{StaticResource H1}" Text="Computador"/>
                    <TextBlock Style="{StaticResource Body}" Margin="0,4,0,16" Text="Especificações e estado atual. Somente leitura."/>

                    <UniformGrid Columns="4" Margin="-6,0">
                        <Border Style="{StaticResource Card}" Margin="6">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Label}" Text="AJUSTES APLICADOS"/>
                                <TextBlock x:Name="ScoreText" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                <TextBlock x:Name="ScoreSub" Style="{StaticResource Body}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Label}" Text="MEMÓRIA"/>
                                <TextBlock x:Name="RamText" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                <TextBlock x:Name="CpuText" Style="{StaticResource Body}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Label}" Text="DISCO DO SISTEMA LIVRE"/>
                                <TextBlock x:Name="DiskText" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                <ProgressBar x:Name="DiskBar" Height="5" Margin="0,8,0,4" Maximum="100" Foreground="{StaticResource Accent}" Background="{StaticResource NaBg}" BorderThickness="0"/>
                                <TextBlock x:Name="DiskSub" Style="{StaticResource Body}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Label}" Text="LIGADO HÁ"/>
                                <TextBlock x:Name="UptimeText" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                <TextBlock x:Name="UptimeSub" Style="{StaticResource Body}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <TextBlock Style="{StaticResource Label}" Text="ESPECIFICAÇÕES" Margin="0,22,0,8"/>
                    <Border Style="{StaticResource Card}" Padding="0">
                        <ItemsControl x:Name="SpecList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Key}" Foreground="{StaticResource Muted}" FontSize="13"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <TextBlock Style="{StaticResource Label}" Text="AJUSTES POR CATEGORIA" Margin="0,22,0,8"/>
                    <ItemsControl x:Name="CategorySummary">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,12,12" Width="200" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource Body}" Text="{Binding Text}"/>
                                        <ProgressBar Height="4" Margin="0,8,0,0" Maximum="1" Value="{Binding Ratio, Mode=OneWay}" Foreground="{StaticResource Accent}" Background="{StaticResource NaBg}" BorderThickness="0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>


            <!-- ============ HISTÓRICO E LOGS ============ -->
            <Grid x:Name="PageHistory" Grid.Row="1" Visibility="Collapsed" Margin="24,20,24,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Histórico e logs"/>
                    <TextBlock Style="{StaticResource Body}" Margin="0,4,0,12" x:Name="HistoryIntro"/>
                    <WrapPanel Margin="0,0,0,12">
                        <Button x:Name="UndoButton" Style="{StaticResource BtnPrimary}" Content="Desfazer aplicação selecionada" Click="Undo_Click" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource BtnBase}" Content="Abrir pasta de logs" Click="OpenLogs_Click"/>
                    </WrapPanel>
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                    <ListView x:Name="HistoryList" BorderThickness="0" Background="Transparent" Foreground="{StaticResource Ink}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Quando" Width="130" DisplayMemberBinding="{Binding When}"/>
                                <GridViewColumn Header="Técnico" Width="170" DisplayMemberBinding="{Binding Operator}"/>
                                <GridViewColumn Header="Usuário" Width="170" DisplayMemberBinding="{Binding TargetUser}"/>
                                <GridViewColumn Header="Alterações" Width="420" DisplayMemberBinding="{Binding Summary}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="REGISTRO DESTA SESSÃO" Margin="0,16,0,6"/>
                <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
                    <TextBox x:Name="LogBox" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="{StaticResource Mono}" FontSize="11.5"
                             Foreground="{StaticResource Muted}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="12,8" TextWrapping="NoWrap"/>
                </Border>
            </Grid>
        </Grid>

        <!-- Confirmação: lista exata do que vai mudar -->
        <!-- Progresso da limpeza: aparece assim que a limpeza começa e some ao terminar -->
        <Grid x:Name="CleanupOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{StaticResource Scrim}">
            <Border Style="{StaticResource Card}" Width="520" Padding="28,24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="CleanupPercent" DockPanel.Dock="Right" Text="0%" FontSize="30" FontWeight="SemiBold"
                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource H1}" Text="Limpando…"/>
                            <TextBlock x:Name="CleanupStep" Style="{StaticResource Body}" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <!-- Border collie (como o do ícone) correndo em cima da barra, acompanhando o progresso -->
                    <Canvas x:Name="DogLane" Height="36" Margin="0,12,0,0" ClipToBounds="False" IsHitTestVisible="False">
                        <Viewbox x:Name="DogView" Width="58" Height="36" Canvas.Left="0" Canvas.Top="1">
                            <Viewbox.Effect>
                                <DropShadowEffect Color="#3CC2B9" ShadowDepth="0" BlurRadius="6" Opacity="0.55"/>
                            </Viewbox.Effect>
                            <Canvas Width="64" Height="40">
                                <Canvas.RenderTransform><TranslateTransform x:Name="DogBob"/></Canvas.RenderTransform>
                                <!-- pernas do lado de lá -->
                                <Canvas>
                                    <Canvas.RenderTransform><RotateTransform x:Name="LegFarBack" Angle="-25" CenterX="18" CenterY="21"/></Canvas.RenderTransform>
                                    <Path Fill="#26292C" Data="M15,19 L21,19 L20,30 L18.5,36.5 L15.5,36.5 L16.5,30 Z"/>
                                    <Path Fill="#C9C9C9" Data="M15.6,34.6 L18.9,34.6 L18.5,37 L15,37 Z"/>
                                </Canvas>
                                <Canvas>
                                    <Canvas.RenderTransform><RotateTransform x:Name="LegFarFront" Angle="25" CenterX="40" CenterY="21"/></Canvas.RenderTransform>
                                    <Path Fill="#26292C" Data="M37.5,19 L42,19 L41.2,36.5 L38,36.5 Z"/>
                                    <Path Fill="#C9C9C9" Data="M38,34.6 L41.3,34.6 L41.3,37 L37.6,37 Z"/>
                                </Canvas>
                                <!-- rabo -->
                                <Canvas>
                                    <Canvas.RenderTransform><RotateTransform x:Name="DogTail" CenterX="13" CenterY="16"/></Canvas.RenderTransform>
                                    <Path Fill="#0D0D0D" Data="M14,15 C8,15.5 4,12.5 1.5,6.5 C4.5,8 7,9 9,9.2 C11,9.8 12.5,11 14,12 Z"/>
                                    <Path Fill="#F4F4F4" Data="M1.5,6.5 C3,7.3 4.5,8 6,8.6 C5,9.6 3.5,9.4 2.6,8.6 Z"/>
                                </Canvas>
                                <!-- corpo e barriga -->
                                <Path Fill="#0D0D0D" Data="M12,15 C14,11 26,10.5 34,11 C40,11 44,13 45,17 C45.5,22 43,25 38,25.5 C30,26.2 20,26.2 15,24.5 C11,23 10.5,18 12,15 Z"/>
                                <Path Fill="#F4F4F4" Data="M24,25.8 C28,24.6 34,24.4 38,25.4 C33,26.3 28,26.3 24,25.8 Z"/>
                                <!-- pernas do lado de cá -->
                                <Canvas>
                                    <Canvas.RenderTransform><RotateTransform x:Name="LegNearBack" Angle="25" CenterX="18" CenterY="20"/></Canvas.RenderTransform>
                                    <Path Fill="#0D0D0D" Data="M14.5,18 L21.5,18 L20.5,29 L19,36 L15.5,36 L16.5,29 Z"/>
                                    <Path Fill="#F4F4F4" Data="M16.1,33 L19.4,33 L19,37 L14.6,37 Z"/>
                                </Canvas>
                                <Canvas>
                                    <Canvas.RenderTransform><RotateTransform x:Name="LegNearFront" Angle="-25" CenterX="41" CenterY="20"/></Canvas.RenderTransform>
                                    <Path Fill="#F4F4F4" Data="M38.5,18 L43.5,18 L42.4,36 L39,36 Z"/>
                                    <Path Fill="#0D0D0D" Data="M38.5,18 L43.5,18 L43,26 L38.9,26 Z"/>
                                </Canvas>
                                <!-- cabeça, colar de pelo branco e orelha -->
                                <Path Fill="#0D0D0D" Data="M37,17 C36.5,10 40,4.5 46.5,4 C52,3.6 55,5.6 57,8.3 L61.5,9.8 C62.6,10.8 62.1,12.8 60.6,13.1 L55,14.2 C52,16 48,18 44,19.5 Z"/>
                                <Path Fill="#F4F4F4" Data="M40.5,7.5 C43,10 45,13.5 45.5,18 C45.8,21.5 44.5,24.5 41.5,25.8 C42,22.5 41.5,20 40.2,18.6 C41.5,18 42,16.5 41.2,14.5 C40.5,12 40,10 40.5,7.5 Z"/>
                                <Path Fill="#0D0D0D" Data="M44.5,5 L43.6,-0.2 L49,3.8 Z"/>
                                <Path Fill="#C98A4B" Data="M45.1,4.1 L44.7,1.4 L47.4,3.5 Z"/>
                                <!-- focinho branco, boca aberta e língua -->
                                <Path Fill="#F4F4F4" Data="M49.8,3.8 C50.6,3.7 51.4,3.9 52,4.3 C52.4,6 53.8,7.3 56,8.3 L61.5,9.8 C62.6,10.8 62.1,12.8 60.6,13.1 L55.4,13.8 C53.5,11.2 51.5,8.5 49.8,3.8 Z"/>
                                <Path Fill="#7A1B1B" Data="M55.4,13.8 L60.6,13.1 C60.1,15.1 58,16.3 56,15.9 Z"/>
                                <Path Fill="#E86A7A" Data="M56.6,14.8 C57.6,14.6 58.6,14.7 59.1,15.2 C58.7,17.7 57.1,18.4 56.4,17.2 Z"/>
                                <Path Fill="White" Data="M59.4,13.25 L60.1,13.15 L59.8,14.2 Z"/>
                                <Path Fill="Black"><Path.Data><EllipseGeometry Center="61.4,10.7" RadiusX="1.05" RadiusY="1.05"/></Path.Data></Path>
                                <!-- sobrancelha caramelo e olho verde -->
                                <Path Fill="#C98A4B"><Path.Data><EllipseGeometry Center="50,6.2" RadiusX="1.3" RadiusY="0.75"/></Path.Data></Path>
                                <Path Fill="#3FAE5A"><Path.Data><EllipseGeometry Center="50.5,8" RadiusX="1.1" RadiusY="1.1"/></Path.Data></Path>
                                <Path Fill="#0D0D0D"><Path.Data><EllipseGeometry Center="50.5,8" RadiusX="0.5" RadiusY="0.5"/></Path.Data></Path>
                                <Path Fill="White"><Path.Data><EllipseGeometry Center="50.85,7.7" RadiusX="0.3" RadiusY="0.3"/></Path.Data></Path>
                                <!-- coleira -->
                                <Path Fill="#2F3337" Data="M41.3,6.6 C43.4,9.8 44.8,13.5 45.2,17.4 L43,17.9 C42.5,14.2 41.3,10.8 39.6,8 Z"/>
                                <Path Stroke="#C0C0C0" StrokeThickness="0.6"><Path.Data><EllipseGeometry Center="44.3,18.4" RadiusX="1" RadiusY="1"/></Path.Data></Path>
                            </Canvas>
                        </Viewbox>
                    </Canvas>
                    <ProgressBar x:Name="CleanupBar" Height="10" Margin="0,0,0,10" Maximum="1"
                                 Foreground="{StaticResource Accent}" Background="{StaticResource NaBg}" BorderThickness="0"/>
                    <TextBlock x:Name="CleanupItemText" Style="{StaticResource Body}" FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="ConfirmOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{StaticResource Scrim}">
            <Border Style="{StaticResource Card}" Width="780" MaxHeight="600" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource H1}" x:Name="ConfirmTitle"/>
                        <TextBlock Style="{StaticResource Body}" x:Name="ConfirmIntro" Margin="0,4,0,12"/>
                    </StackPanel>
                    <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource BtnBase}" Content="Cancelar" Click="ConfirmCancel_Click" Margin="0,0,8,0" IsCancel="True"/>
                        <Button x:Name="ConfirmOk" Style="{StaticResource BtnPrimary}" Content="Aplicar agora" Click="ConfirmOk_Click"/>
                    </WrapPanel>
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4">
                        <ListBox x:Name="ConfirmList" BorderThickness="0" Padding="6" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,3"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
